-extern "C" __global__ __aicore__ void kv_compress_epilog(
-    GM_ADDR kv_compress_cache,
-    GM_ADDR x,
-    GM_ADDR slot_mapping,
-    GM_ADDR kv_compress_cache_out,
-    GM_ADDR workspace,
-    GM_ADDR tiling)
-{
-    if (workspace == nullptr) {
-        return;
-    }
-
-    GM_ADDR userspace = GetUserWorkspace(workspace);
