+        patch.object(cache_patch, "group_cache_specs", return_value=specs),
+        patch.object(cache_patch, "make_cache_groups", return_value=groups),
+    ):
+        assert cache_patch._ascend_get_packed_kv_cache_groups(config, specs) is groups
