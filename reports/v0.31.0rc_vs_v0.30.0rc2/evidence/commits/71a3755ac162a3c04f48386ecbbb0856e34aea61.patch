+    def __init__(
+        self,
+        shape,
+        npu_format,
+        *,
+        dtype=torch.float16,
+        storage_offset=0,
+        stride=None,
+    ):
+        self.shape = torch.Size(shape)
+        self.dtype = dtype
+        self.layout = torch.strided
+        self.device = torch.device("npu")
