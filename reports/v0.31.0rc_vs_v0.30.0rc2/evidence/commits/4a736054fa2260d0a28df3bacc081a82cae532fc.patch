-          kubectl delete -f ./lws.yaml --ignore-not-found=true || true
+          kubectl delete -f ./lws.yaml --ignore-not-found=true --wait=false || true
 
           echo "Waiting for pods of [$LWS_NAME] to fully terminate..."
           TIMEOUT=300
@@ -621,6 +656,70 @@ jobs:
             sleep $SLEEP_INTERVAL
           done
 
+      - name: Collect requested paths from test pods
+        if: ${{ always() && inputs.download_path != '' }}
+        id: collect_download
+        continue-on-error: true
+        env:
+          DOWNLOAD_PATH: ${{ inputs.download_path }}
+          ARTIFACT_LABEL: ${{ inputs.vllm_ascend_branch }}-${{ inputs.name || inputs.config_file_path }}
+        run: |
+          python3 .github/workflows/scripts/collect_download.py "$DOWNLOAD_PATH" --list --node-count ${{ inputs.size }} > /tmp/download-paths.tsv
+          mkdir -p /tmp/download-artifact
+          for attempt in $(seq 1 12); do
+            pending=0
+            while IFS=$'\t' read -r NODE REQUESTED_PATH; do
+              [ -f "${LOG_PREFIX}/${NODE}_download.tar.gz" ] && continue
+              index="${NODE#node}"
+              if [ "$index" -eq 0 ]; then
+                pod="${LWS_NAME}-0"
+              else
+                pod="${LWS_NAME}-0-${index}"
+              fi
+              phase=$(kubectl get pod "$pod" -n "$NAMESPACE" -o jsonpath='{.status.phase}' 2>/dev/null || true)
+              if [ "$phase" = "Running" ] || [ "$phase" = "Pending" ]; then
+                pending=1
+              fi
+            done < /tmp/download-paths.tsv
+            [ "$pending" -eq 0 ] && break
+            echo "Waiting for requested archives (attempt $attempt/12)"
+            sleep 5
+          done
+          copied=0
+          while IFS=$'\t' read -r NODE REQUESTED_PATH; do
+            source_archive="${LOG_PREFIX}/${NODE}_download.tar.gz"
+            if [ -f "$source_archive" ]; then
+              cp "$source_archive" "/tmp/download-artifact/${NODE}.tar.gz"
+              echo "Collected ${NODE}: ${REQUESTED_PATH} -> ${NODE}.tar.gz ($(wc -c < "$source_archive") bytes)"
+              copied=$((copied + 1))
+            else
+              echo "::warning::No archive from ${NODE} for ${REQUESTED_PATH}"
+            fi
+          done < /tmp/download-paths.tsv
+          if [ "$copied" -eq 0 ]; then
+            echo "::warning::No requested paths were archived by test pods"
+            exit 1
+          fi
+          safe_label=$(printf '%s' "$ARTIFACT_LABEL" | tr -c 'A-Za-z0-9_.-' '-' | cut -c1-100)
+          echo "name=nightly-download-${safe_label}" >> "$GITHUB_OUTPUT"
+
+      - name: Upload requested paths
+        if: ${{ always() && steps.collect_download.outcome == 'success' }}
+        id: upload_download
+        continue-on-error: true
+        uses: actions/upload-artifact@v7
+        with:
+          name: ${{ steps.collect_download.outputs.name }}
+          path: /tmp/download-artifact/
+          if-no-files-found: error
+          retention-days: 7
+          compression-level: 0
+
+      - name: Remove uploaded archives from shared storage
+        if: ${{ always() && steps.upload_download.outcome == 'success' }}
+        continue-on-error: true
+        run: rm -f "${LOG_PREFIX}"/node*_download.tar.gz
+
       - name: Collect Ascend logs
         if: always()
         run: |
