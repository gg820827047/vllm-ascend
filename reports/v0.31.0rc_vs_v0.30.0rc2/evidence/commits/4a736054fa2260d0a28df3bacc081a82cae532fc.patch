+                echo "::warning::Could not archive $requested_path from $pod before deletion"
+              fi
+            done < <(python3 .github/workflows/scripts/collect_download.py \
+              "$DOWNLOAD_PATH" --list --node-count ${{ inputs.size }})
+          fi
+
           echo "Current pod status:"
           kubectl get pods -n "$NAMESPACE" --ignore-not-found=true
 
