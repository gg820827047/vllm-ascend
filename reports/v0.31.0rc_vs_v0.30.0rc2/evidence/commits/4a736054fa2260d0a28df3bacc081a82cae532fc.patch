@@ -593,12 +605,35 @@ jobs:
 
       - name: Post process
         if: always()
+        env:
+          DOWNLOAD_PATH: ${{ inputs.download_path }}
         run: |
+          # Archive once after the test finishes, before deleting running pods.
+          # The exit trap covers pods that exit earlier.
+          if [ -n "$DOWNLOAD_PATH" ]; then
