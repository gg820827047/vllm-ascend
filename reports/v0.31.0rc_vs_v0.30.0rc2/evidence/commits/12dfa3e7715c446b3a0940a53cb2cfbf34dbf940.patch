+        worker._process_save_for_layer_batch([req], 0)
+        worker._process_save_for_layer_batch([req], 1)
+
+        expected_runs = [(0, 1), (2, 3)]
+        for layer in (0, 1):
+            runs = [(r.start_block, r.end_block) for r in worker.layer_save_tasks[layer][0].block_ranges]
