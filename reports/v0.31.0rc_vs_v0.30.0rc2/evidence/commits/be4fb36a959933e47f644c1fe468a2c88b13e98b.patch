    cd tests/e2e
    python tests/e2e/batch_aisbench.py /root/benchmark -N 8 --models Qwen3-8B Qwen3-VL-8B-Instruct-w8a8-QuaRot Qwen3-30B-A3B MiniMax-M2.7-w8a8-QuaRot --tps 2 2 2 4 --dps 1 1 2 --eps 0 0 1 --mtps 0 -MNS 512 -MML 8192 -GMU 0.90 -MRV2 -X 2 1 0 -BX --debug --timeout 1800
