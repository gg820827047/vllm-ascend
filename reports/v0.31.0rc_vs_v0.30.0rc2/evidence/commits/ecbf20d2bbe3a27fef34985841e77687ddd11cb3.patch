+import os
+from unittest.mock import patch
+
+import pytest
+from vllm import SamplingParams
+from vllm.v1.metrics.reader import Counter, Vector
+
+from tests.e2e.conftest import VllmRunner, wait_until_npu_memory_free
+from tests.e2e.pull_request.one_card.model_runner_v2.utils import calculate_acceptance_per_pos
+
+MODEL = "Qwen/Qwen3-8B"
+DRAFT_MODEL = "Qwen/Qwen3-0.6B"
+MIN_ACCEPTED_DRAFT_TOKENS_PER_ROUND = 0.1
+
+
+@pytest.mark.e2e_model(MODEL)
+@patch.dict(os.environ, {"VLLM_USE_V2_MODEL_RUNNER": "1"})
+@wait_until_npu_memory_free(target_free_percentage=0.8)
+def test_qwen3_plain_draft_model_spec_decoding() -> None:
+    """Smoke-test plain draft-model speculative decoding on ModelRunner V2."""
+    prompts = [
+        "Hello, my name is",
+        "The president of the United States is",
+        "The capital of France is",
+        "The future of AI is",
+    ]
+    num_speculative_tokens = 3
+    sampling_params = SamplingParams(max_tokens=32, temperature=0.0)
+
+    with VllmRunner(
+        MODEL,
+        max_model_len=1024,
+        enforce_eager=True,
+        async_scheduling=True,
+        disable_log_stats=False,
+        enable_prefix_caching=False,
+        speculative_config={
+            "method": "draft_model",
+            "model": DRAFT_MODEL,
+            "num_speculative_tokens": num_speculative_tokens,
+        },
+    ) as runner:
+        runner.model.generate(prompts, sampling_params)
+        metrics = runner.model.get_metrics()
+
+    acceptance_per_pos = calculate_acceptance_per_pos(
+        metrics,
+        num_speculative_tokens,
+        Counter,
+        Vector,
+    )
+
+    golden = [0.82, 0.64, 0.42]
+    match = all(abs(a - b) < 0.1 for a, b in zip(acceptance_per_pos, golden))
+    assert match, f"acceptance_per_pos {acceptance_per_pos} does not match golden {golden}"
