+            # Real batch_alloc failures are logged as errors by the caller.
             zero_count = int(np.sum(base_gvas_arr <= 0))
-            logger.warning(
+            logger.debug(
                 "[KVPOOL] build_transfer layer=%d detected %d zero/negative base_gvas "
