+      # Maintenance window gate. Controlled by the repository variable
+      # NIGHTLY_COMMAND_BLOCK_WINDOW. The value is an optional switch followed by
+      # an HH:MM-HH:MM window in Beijing time (UTC+8, cross-midnight supported),
+      # for example "true 22:00-08:00", "false 22:00-08:00" or just
+      # "22:00-08:00". Switch aliases: true/1/yes/on and false/0/no/off
+      # (case-insensitive); space or comma separators are accepted. When enabled
+      # and the current Beijing time falls inside the window, the /nightly and
+      # /weekly comment triggers are blocked. Unset, explicitly disabled or
+      # malformed values disable the gate (fail-open).
+      - name: Check command block window
+        id: block_window
         if: steps.auth.outputs.is_authorized == 'true'
+        env:
+          BLOCK_WINDOW: ${{ vars.NIGHTLY_COMMAND_BLOCK_WINDOW }}
+          COMMAND: ${{ github.event.action }}
+        run: |
+          echo "command=${COMMAND%-command}" >> "$GITHUB_OUTPUT"
+          BLOCKED="false"
+          RAW="$(echo "$BLOCK_WINDOW" | tr ',' ' ' | xargs)"
+          ENABLED="auto"
+          WINDOW=""
+          if [ -n "$RAW" ]; then
+            read -r FIRST SECOND _REST <<< "$RAW"
+            case "$(echo "$FIRST" | tr '[:upper:]' '[:lower:]')" in
+              true|1|yes|on)
+                ENABLED="true"
+                WINDOW="$SECOND"
+                ;;
+              false|0|no|off)
+                ENABLED="false"
+                WINDOW="$SECOND"
+                ;;
+              *)
+                ENABLED="auto"
+                WINDOW="$FIRST"
+                ;;
+            esac
+          fi
+          if [ "$ENABLED" = "false" ]; then
+            echo "NIGHTLY_COMMAND_BLOCK_WINDOW explicitly disabled."
+          elif [ -z "$WINDOW" ]; then
+            if [ "$ENABLED" = "true" ]; then
+              echo "::warning::Gate enabled in NIGHTLY_COMMAND_BLOCK_WINDOW but no window is set (expected HH:MM-HH:MM); block window disabled."
+            else
+              echo "NIGHTLY_COMMAND_BLOCK_WINDOW is not set; block window disabled."
+            fi
+          elif [[ ! "$WINDOW" =~ ^([0-9]{2}):([0-9]{2})-([0-9]{2}):([0-9]{2})$ ]]; then
+            echo "::warning::Invalid NIGHTLY_COMMAND_BLOCK_WINDOW='$WINDOW' (expected HH:MM-HH:MM); block window disabled."
+          else
+            SH=${BASH_REMATCH[1]}
+            SM=${BASH_REMATCH[2]}
+            EH=${BASH_REMATCH[3]}
+            EM=${BASH_REMATCH[4]}
+            if (( 10#$SH > 23 || 10#$SM > 59 || 10#$EH > 23 || 10#$EM > 59 )); then
+              echo "::warning::Out-of-range time in NIGHTLY_COMMAND_BLOCK_WINDOW='$WINDOW'; block window disabled."
+            else
+              START_MIN=$((10#$SH * 60 + 10#$SM))
+              END_MIN=$((10#$EH * 60 + 10#$EM))
+              NOW_MIN=$((10#$(date -u -d '+8 hours' +%H) * 60 + 10#$(date -u -d '+8 hours' +%M)))
+              if (( START_MIN <= END_MIN )); then
+                if (( NOW_MIN >= START_MIN && NOW_MIN < END_MIN )); then
+                  BLOCKED="true"
+                fi
+              else
+                if (( NOW_MIN >= START_MIN || NOW_MIN < END_MIN )); then
+                  BLOCKED="true"
+                fi
+              fi
+            fi
+          fi
+          {
+            echo "blocked=$BLOCKED"
+            echo "window=$WINDOW"
+          } >> "$GITHUB_OUTPUT"
+          if [ "$BLOCKED" = "true" ]; then
+            echo "Command /${COMMAND%-command} is blocked until the maintenance window ends."
+          fi
+
+      - name: Post blocked comment
+        if: steps.auth.outputs.is_authorized == 'true' && steps.block_window.outputs.blocked == 'true'
+        uses: peter-evans/create-or-update-comment@v5
+        with:
+          token: ${{ secrets.PAT_TOKEN }}
+          repository: ${{ github.event.client_payload.github.payload.repository.full_name }}
+          comment-id: ${{ github.event.client_payload.github.payload.comment.id }}
+          body: |
+            [Bot]: `/${{ steps.block_window.outputs.command }}` is temporarily disabled during the maintenance window (Beijing time `${{ steps.block_window.outputs.window }}`). Please retry after the window ends.
+          reactions: confused
+
+      - name: Install Python dependencies
+        if: steps.auth.outputs.is_authorized == 'true' && steps.block_window.outputs.blocked != 'true'
         run: pip3 install pyyaml -q
 
       - name: Resolve test cases and branch
         id: resolve
-        if: steps.auth.outputs.is_authorized == 'true'
+        if: steps.auth.outputs.is_authorized == 'true' && steps.block_window.outputs.blocked != 'true'
         env:
           GH_TOKEN: ${{ secrets.PAT_TOKEN }}
           ALL_ARGS: ${{ github.event.client_payload.slash_command.args.all }}
