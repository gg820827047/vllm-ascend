+                    "kv_connector":"AscendStoreConnector",
+                    "kv_role":"kv_producer",
+                    "kv_connector_extra_config":{
+                        "lookup_rpc_port":"0",
+                        "backend":"mooncake",
+                        "use_layerwise":false
+                    }
+                }
+            ]
+        }
+    }'
+```
+
+Start the four DP4/TP4 Prefill engines with the launcher command from Section 5.2.2.2 after all Decode engines are ready.
