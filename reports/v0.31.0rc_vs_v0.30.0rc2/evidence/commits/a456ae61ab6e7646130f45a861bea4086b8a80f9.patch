+class FakeMoE:
+    """Attribute-compatible stand-in for AscendKimiMoE."""
+
+    num_shared_experts = 2
+    n_routed_experts = 256
+    n_logical_experts = 256
+    n_redundant_experts = 8
+    n_physical_experts = 264
+    n_local_physical_experts = 33
+    experts = object()
