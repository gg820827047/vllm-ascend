-                    LayoutDst const &dstLayout, LayoutSrc const &srcLayout, uint8_t unitFlag = 0)
-    {
-        // 950 L0C→GM：与仓内 KDA 相同的 DataCopyCO12Dst + SetFixpipeNz2ndFlag。
-        // mSize 用实际 M（dstLayout），srcStride 用 L0C 16 对齐步长。
