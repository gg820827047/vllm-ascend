-inline uint64_t GetDefaultStride0(const gert::Shape &shape)
-{
-    uint64_t stride = 1;
-    for (size_t dim = 1; dim < shape.GetDimNum(); ++dim) {
-        stride *= static_cast<uint64_t>(shape.GetDim(dim));
-    }
-    return stride;
-}
