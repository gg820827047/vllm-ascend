-// 简单可复现的伪随机源，取值落在 [-1, 1)。
-float PseudoRandom(uint32_t seed)
-{
-    seed = seed * kPrngMulA + kPrngAddA;
-    seed ^= seed >> kPrngXorShiftA;
-    seed = seed * kPrngMulB;
-    seed ^= seed >> kPrngXorShiftB;
-    return static_cast<float>(seed % kPrngMod) / kPrngDiv - 1.0F;
-}
