-    __aicore__ inline void ProcessCubeC2Ub(Catlass::Arch::Resource<ArchTag> &resource, BlockMmad &blockMmad,
-                                           uint32_t coreIdx, uint32_t coreNum, uint64_t coreKScratch,
-                                           uint32_t totalTasks)
