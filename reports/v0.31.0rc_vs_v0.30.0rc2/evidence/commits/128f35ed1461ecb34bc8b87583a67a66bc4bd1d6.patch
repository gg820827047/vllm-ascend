-    using LayoutDst = layout::RowMajor;
-    using LayoutSrc = layout::RowMajor;
-
-    static constexpr uint32_t ELE_NUM_PER_BLK = BytesToBits(BYTE_PER_BLK) / SizeOfBits<Element>::value;
