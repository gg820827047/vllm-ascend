-    __aicore__ inline void ProcessOnePass(const AscendC::GlobalTensor<ElementS> &gS, const MsaTask &task,
-                                          uint32_t blkBase, uint32_t rowOff, uint32_t rows)
-    {
-        ProcessPass(gS, task, blkBase, rowOff, rows);
