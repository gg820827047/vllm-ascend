-    AscendC::LocalTensor<float> ubS_;
-    AscendC::LocalTensor<half> ubS16_;
-    AscendC::LocalTensor<half> ubS16Ping_[S16_STAGES];
-    AscendC::LocalTensor<float> ubT64_;
-    AscendC::LocalTensor<float> ubT8_;
