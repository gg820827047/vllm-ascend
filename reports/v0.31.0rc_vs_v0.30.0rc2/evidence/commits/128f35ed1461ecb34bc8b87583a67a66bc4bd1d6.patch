-    __aicore__ inline void BeginSTile(uint32_t blkBase)
-    {
-        if (mSub_ == 0U) {
-            return;
-        }
-        if (stageOn_ && (blkBase >= stageBlkBase_ + MSA_STAGE_BLOCKS)) {
-            FlushStage();
-            stageBlkBase_ = blkBase;
-            stageBlkEnd_ = blkBase;
-        }
-    }
