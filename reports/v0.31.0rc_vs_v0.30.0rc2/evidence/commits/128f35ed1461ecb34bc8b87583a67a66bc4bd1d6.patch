-    scoreShape->SetDim(1, totalQ);    // 1: totalQ
-    scoreShape->SetDim(MSA_SCORE_DIM_BLOCK, RoundUpTo(maxBlocks, MSA_SCORE_STRIDE_ALIGN));
-
-    OP_LOGI(context->GetNodeName(), "MsaIndexScore InferShape end.");
-    return ge::GRAPH_SUCCESS;
-}
