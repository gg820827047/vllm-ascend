-    const bool useKScratch = info.isQuant || (info.keyLayout == MSA_KEY_LAYOUT_TND);
-    uint32_t scratchElemBytes = sizeof(uint16_t);
-    if (info.isAscend950 && !info.isQuant && IsFp8ComputeDtype(info.queryDtype)) {
