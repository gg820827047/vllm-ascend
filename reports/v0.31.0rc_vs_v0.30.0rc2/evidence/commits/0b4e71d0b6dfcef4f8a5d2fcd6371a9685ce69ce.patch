-ge::graphStatus TilingForLightningIndexerQuant(gert::TilingContext *context)
-{
-    OPS_ERR_IF(context == nullptr, OPS_REPORT_VECTOR_INNER_ERR("LightningIndexerQuant", "Tiling context is null."),
