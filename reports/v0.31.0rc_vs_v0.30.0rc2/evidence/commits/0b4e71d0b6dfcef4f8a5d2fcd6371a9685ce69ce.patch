-        int32_t cuS2Len = cuBaseS2Idx + s2BaseSize_ >= cuRealAcSeq ? cuRealAcSeq - cuBaseS2Idx : s2BaseSize_;
-        int32_t cuS1Idx = cuS1BeginIdxPerAiv + innerS1Idx;
