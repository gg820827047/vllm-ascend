-            } else if (mrgGroups == MRG_BLOCK_2) {
-                params.validBit = 0b0011;
-            } else if (mrgGroups == MRG_BLOCK_3) {
-                params.validBit = 0b0111;
-            } else if (mrgGroups == MRG_BLOCK_4) {
