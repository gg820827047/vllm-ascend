-                                                  const MmInfo &mmInfo, const LIQCommon::RunInfo &runInfo)
-{
-    WaitFlag<HardEvent::FIX_M>(FIX_M_EVENT + l0cBufIdx_ % DOUBLE_BUF_NUM);
