-            continue;
-        }
-        for (uint32_t s1gIdx = 0; s1gIdx < s1GBaseNum; s1gIdx++) {
-            s2BaseNum = GetS2BaseBlockNumOnMask(s1gIdx, actS1Size, actS2Size);
-            totalBlockNum += s2BaseNum * constInfo.kHeadNum;
-        }
-    }
-    return totalBlockNum;
-}
