    [Feature][Xlite] Support w4a8 quantization for xlite (#19169)
    
    ### What this PR does / why we need it?
    
    This PR makes the vllm-ascend xlite adapter (`StandardXliteModel` in
    `vllm_ascend/xlite/xlite.py`) correctly load **W4A8 per-channel
    quantized** checkpoints produced by msModelSlim, so W4A8 quantized MoE
    models can run on the xlite runtime. Two changes, both in the
    weight-loading path:
    1. Pass through pre-packed `int64` weight scales in
    `_transform_deq_scale()`
    2. Load the expert `scale_bias` tensors for routed experts
    
    ### Does this PR introduce _any_ user-facing change?
    
    No, reuse the existing w4a8-related configurations and paths.
    
    ### How was this patch tested?
    
    Manual verification on Atlas 800T A2 platform:
    
    1. Quantized a MoE model GLM-5.1-w4a8 with msModelSlim to W4A8
    per-channel (routed experts quantized).
    2. Served it with the xlite runtime
    3. Sent sample prompts and compared the outputs against the non-xlite
    baseline
    
    
    - vLLM main:
    https://github.com/vllm-project/vllm/commit/c4df37dfcc7f72ca41cd43801a468526ecf99a2b
    
    Signed-off-by: wwwumr <1127858301@qq.com>

diff --git a/vllm_ascend/xlite/xlite.py b/vllm_ascend/xlite/xlite.py
index d9fb90273..ec56e8ea7 100644
--- a/vllm_ascend/xlite/xlite.py
+++ b/vllm_ascend/xlite/xlite.py
@@ -285,6 +285,8 @@ class XliteModelBase(ABC):
         Returns:
             torch.Tensor: The repacked scale tensor for fixpipe computation.
         """
+        if deq_scale.dtype == torch.int64:
+            return deq_scale
         deq_scale_fp32 = deq_scale.to(torch.float32)
         scale = deq_scale_fp32.new_zeros(deq_scale.shape[0] * 2)
         scale[0::2] = deq_scale_fp32[0::1]
@@ -445,6 +447,9 @@ class StandardXliteModel(XliteModelBase):
         xlite_config.quant_attn_weight_nz = bool(xlite_model.mha_qkv) and self.is_tensor_nz(xlite_model.mha_qkv[0])
         xlite_config.quant_attn_weight_transpose = bool(xlite_model.mha_qkv)
 
+        xlite_model.re_up_gate_scale_bias = get_layer_weights(layers, f"{re_prefix}.w13_scale_bias", **re_kwargs)
+        xlite_model.re_down_scale_bias = get_layer_weights(layers, f"{re_prefix}.w2_scale_bias", **re_kwargs)
+
         re_kwargs["post_processor"] = self._transform_deq_scale
         xlite_model.re_up_gate_scale = get_layer_weights(layers, f"{re_prefix}.w13_weight_scale", **re_kwargs)
         xlite_model.re_down_scale = get_layer_weights(layers, f"{re_prefix}.w2_weight_scale", **re_kwargs)
