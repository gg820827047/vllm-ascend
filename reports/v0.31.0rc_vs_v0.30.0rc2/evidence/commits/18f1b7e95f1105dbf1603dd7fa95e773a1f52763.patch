             OS_MARK="-openeuler"
@@ -208,9 +213,10 @@ jobs:
               DATE="${{ inputs.base_image_date }}"
             fi
             TAG_SUFFIX="-cann${CANN_VERSION_LOWER}-${DATE}"
+            RUN_MARK="-r${GITHUB_RUN_NUMBER}"
           fi
 
-          FULL_TAG="${TAG_PREFIX}-${BRANCH_TAG}-${{ inputs.target }}${OS_MARK}${TAG_SUFFIX}"
+          FULL_TAG="${TAG_PREFIX}-${BRANCH_TAG}-${{ inputs.target }}${OS_MARK}${TAG_SUFFIX}${RUN_MARK}"
           if [ "${{ inputs.build_type }}" = "daily" ]; then
             IMAGE="${SWR_TEMP_REGISTRY}:${FULL_TAG}-${{ matrix.arch_name }}"
           else
@@ -312,10 +318,11 @@ jobs:
           BRANCH_TAG="${{ inputs.vllm_ascend_branch }}"
           BRANCH_TAG=$(echo "$BRANCH_TAG" | tr '/' '-')
           CANN_VERSION_LOWER=$(echo "${{ inputs.cann_version }}" | tr '[:upper:]' '[:lower:]')
-          # Daily tag pattern: daily-<branch>-<target>[-openeuler]-cann<ver>-<date>,
-          # where <date> is the schedule daily base image date. Ubuntu and openeuler
-          # base images may be built on different days, so resolve the date per OS
-          # variant using the same backtracking logic as the build step.
+          # Daily tag pattern: daily-<branch>-<target>[-openeuler]-cann<ver>-<date>-r<run_number>,
+          # where <date> is the schedule daily base image date and <run_number> makes every
+          # build unique so it is not overwritten in the green region after the blue->green
+          # SWR sync. Ubuntu and openeuler base images may be built on different days, so
+          # resolve the date per OS variant using the same backtracking logic as the build step.
           BASE_TAG="daily-${BRANCH_TAG}-${{ inputs.target }}"
           # Base image chip suffix: a2 has none, other targets use the target name.
           TARGET_MARK=""
@@ -354,8 +361,13 @@ jobs:
               continue
             fi
 
-            TAG="${BASE_TAG}${OS_MARK}-cann${CANN_VERSION_LOWER}-${DATE}"
+            TAG="${BASE_TAG}${OS_MARK}-cann${CANN_VERSION_LOWER}-${DATE}-r${GITHUB_RUN_NUMBER}"
+            # Also publish a moving date-only alias so callers that reference
+            # daily-<branch>-<target>[-<os>]-cann<ver>-<date> keep resolving; it always
+            # points at the newest build for that day.
+            ALIAS_TAG="${BASE_TAG}${OS_MARK}-cann${CANN_VERSION_LOWER}-${DATE}"
             MANIFEST_TAG="${MAIN_REGISTRY}:${TAG}"
+            ALIAS_MANIFEST_TAG="${MAIN_REGISTRY}:${ALIAS_TAG}"
             AMD64_TAG="${TEMP_REGISTRY}:${TAG}-amd64"
             ARM64_TAG="${TEMP_REGISTRY}:${TAG}-arm64"
 
@@ -375,6 +387,7 @@ jobs:
