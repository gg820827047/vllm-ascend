+    server_cmd: *server_cmd
+    server_cmd_extra:
+      - "--speculative-config"
+      - '{"method":"dspark","num_speculative_tokens":15,"enforce_eager":false}'
+    test_content:
+      - chat_completion
+    prompts:
+      - seed: "x "
+        target_tokens: 200
+    api_keyword_args:
+      max_tokens: 200
+      temperature: 0.0
+    expected_response:
+      completion_tokens: 200
+    benchmarks:
+      perf:
+        case_type: performance
+        dataset_path: /root/.cache/modelscope/hub/datasets/vllm-ascend/DeepSeek-V4-Flash_input_3500_lines_128
+        request_conf: vllm_api_stream_chat
+        dataset_conf: gsm8k/gsm8k_gen_0_shot_cot_str_perf
+        num_prompts: 128
+        max_out_len: 1500
+        batch_size: 32
+        request_rate: 0
+        baseline: 2241.98294
+        threshold: 0.95
+        temperature: 0
+        ignore_eos: True
+  - name: "DeepSeek-V4-Flash-DSpark-AdaptiveVerification"
