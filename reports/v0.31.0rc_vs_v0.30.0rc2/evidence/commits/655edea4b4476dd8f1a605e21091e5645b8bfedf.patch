+    #!/usr/bin/env bash
+    set -eo pipefail
+
+    VISIBLE_DEVICES=${1:?need visible_devices}
+    PORT=${2:?need port}
+    DP_SIZE=${3:?need dp_size}
+    DP_RANK=${4:?need dp_rank}
