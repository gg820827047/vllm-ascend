+    norm = SimpleNamespace(weight=SimpleNamespace(data=object()), variance_epsilon=1e-6)
+    impl = SimpleNamespace(
+        use_flashmla=True,
+        use_mla_rope=True,
+        fa_quant_layer=False,
+        q_a_layernorm=norm,
