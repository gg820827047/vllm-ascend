index 386d2da35..76fb07a23 100644
--- a/tests/ut/core/test_dyntra_lb_scheduler.py
+++ b/tests/ut/core/test_dyntra_lb_scheduler.py
@@ -1369,3 +1369,133 @@ def test_dyntra_lb_lifecycle_hooks_clear_paused_state(monkeypatch):
     )
