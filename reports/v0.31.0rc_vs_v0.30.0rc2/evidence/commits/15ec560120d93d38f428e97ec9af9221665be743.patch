+        """out_dtype=None (upstream dsv2/glm5next wiring) defaults to fp32:
+        bf16 weights take tier 4 directly; fp32 weights cast x instead of
+        raising a dtype mismatch."""
+        gate = AscendGateLinear(
+            input_size=16,
+            output_size=4,
+            bias=False,
+            out_dtype=None,
+            prefix="test.gate",
+        )
