digraph G {
graph [rankdir=TB, bgcolor="transparent", pad="0.2", nodesep="0.4", ranksep="0.45", fontname="Noto Sans CJK SC"];
node [shape=box, style="rounded,filled", color="#bccbda", fontname="Noto Sans CJK SC", fontsize=13, margin="0.16,0.12"];
edge [fontname="Noto Sans CJK SC", fontsize=11, color="#5b6f84", arrowsize=0.7];

"entry" [label="vllm-ascend 安装包\nentry_points",fillcolor="#e6f3e9",URL="#src-entry",tooltip="vllm-ascend 安装包\nentry_points"];
"platform" [label="platform_plugins\nregister → NPUPlatform",fillcolor="#e6f3e9",URL="#src-platform",tooltip="platform_plugins\nregister → NPUPlatform"];
"worker-select" [label="worker_cls 选型\nNPUWorker",fillcolor="#e6f3e9",URL="#src-worker-select",tooltip="worker_cls 选型\nNPUWorker"];
"wrapper-init" [label="vLLM WorkerWrapperBase\n按 worker_cls 创建 Worker",fillcolor="#e7f0fc",URL="#src-wrapper-init",tooltip="vLLM WorkerWrapperBase\n按 worker_cls 创建 Worker"];
"runner-select" [label="NPUWorker.init_device\n选择 MRV2 / MRV1",fillcolor="#e6f3e9",URL="#src-runner-select",tooltip="NPUWorker.init_device\n选择 MRV2 / MRV1"];
"model-register" [label="general_plugins\nModelRegistry 注册 architecture",fillcolor="#e6f3e9",URL="#src-model-register",tooltip="general_plugins\nModelRegistry 注册 architecture"];
"architecture" [label="hf_config.architectures\nresolve_model_cls",fillcolor="#e7f0fc",URL="#src-architecture",tooltip="hf_config.architectures\nresolve_model_cls"];
"core-load" [label="model_loader.load_model\n实例保存为 Runner.model",fillcolor="#e7f0fc",URL="#src-core-load",tooltip="model_loader.load_model\n实例保存为 Runner.model"];
"outer-model" [label="AscendDeepseekV41ForCausalLM\n已创建的模型实例",fillcolor="#e6f3e9",URL="#src-outer-model",tooltip="AscendDeepseekV41ForCausalLM\n已创建的模型实例"];
"entry" -> "platform" [label="平台插件",style="solid"];
"platform" -> "worker-select" [label="平台更新配置",style="solid"];
"worker-select" -> "wrapper-init" [label="类名绑定",style="dashed"];
"wrapper-init" -> "runner-select" [label="创建/初始化",style="solid"];
"entry" -> "model-register" [label="模型插件",style="solid"];
"model-register" -> "architecture" [label="注册表映射",style="dashed"];
"runner-select" -> "core-load" [label="Runner.load_model",style="solid"];
"architecture" -> "core-load" [label="提供模型类",style="dashed"];
"core-load" -> "outer-model" [label="实例化并加载权重",style="solid"];
}