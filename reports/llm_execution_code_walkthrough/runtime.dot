digraph G {
graph [rankdir=TB, bgcolor="transparent", pad="0.2", nodesep="0.4", ranksep="0.45", fontname="Noto Sans CJK SC"];
node [shape=box, style="rounded,filled", color="#bccbda", fontname="Noto Sans CJK SC", fontsize=13, margin="0.16,0.12"];
edge [fontname="Noto Sans CJK SC", fontsize=11, color="#5b6f84", arrowsize=0.7];

"engine-step" [label="① EngineCore\nstep / step_with_batch_queue",fillcolor="#e7f0fc",URL="#src-engine-step",tooltip="① EngineCore\nstep / step_with_batch_queue"];
"scheduler" [label="② Scheduler.schedule\n生成 SchedulerOutput",fillcolor="#e7f0fc",URL="#src-scheduler",tooltip="② Scheduler.schedule\n生成 SchedulerOutput"];
"executor" [label="③ MultiprocExecutor.execute_model\ncollective_rpc",fillcolor="#e7f0fc",URL="#src-executor",tooltip="③ MultiprocExecutor.execute_model\ncollective_rpc"];
"rpc-recv" [label="④ WorkerProc / WorkerWrapperBase\n接收命令并转发",fillcolor="#e7f0fc",URL="#src-rpc-recv",tooltip="④ WorkerProc / WorkerWrapperBase\n接收命令并转发"];
"npu-worker" [label="⑤ NPUWorker.execute_model\nself.model_runner",fillcolor="#e6f3e9",URL="#src-npu-worker",tooltip="⑤ NPUWorker.execute_model\nself.model_runner"];
"ascend-execute" [label="⑥ Ascend NPUModelRunner V2\nexecute_model",fillcolor="#e6f3e9",URL="#src-ascend-execute",tooltip="⑥ Ascend NPUModelRunner V2\nexecute_model"];
"core-execute" [label="⑦ vLLM GPUModelRunner\nexecute_model 通用骨架",fillcolor="#e7f0fc",URL="#src-core-execute",tooltip="⑦ vLLM GPUModelRunner\nexecute_model 通用骨架"];
"metadata" [label="Ascend / EngramModelState\n输入与 Attention 元数据",fillcolor="#e6f3e9",URL="#src-metadata",tooltip="Ascend / EngramModelState\n输入与 Attention 元数据"];
"outer-model" [label="⑧ Runner.self.model(...)\nDeepSeekV4.1 Ascend 实例",fillcolor="#e6f3e9",URL="#src-outer-model",tooltip="⑧ Runner.self.model(...)\nDeepSeekV4.1 Ascend 实例"];
"worker-sample" [label="⑨ 第二条 RPC：sample_tokens\nlogits / sampling / 可选 draft",fillcolor="#e6f3e9",URL="#src-worker-sample",tooltip="⑨ 第二条 RPC：sample_tokens\nlogits / sampling / 可选 draft"];
"update" [label="⑩ Scheduler.update_from_output\n更新进度并输出 / 下一步",fillcolor="#e7f0fc",URL="#src-update",tooltip="⑩ Scheduler.update_from_output\n更新进度并输出 / 下一步"];
"engine-step" -> "scheduler" [label="调用",style="solid"];
"scheduler" -> "executor" [label="计划返回 EngineCore 后提交",style="solid"];
"executor" -> "rpc-recv" [label="跨进程消息队列",style="dashed"];
"rpc-recv" -> "npu-worker" [label="调用已绑定 Worker",style="solid"];
"npu-worker" -> "ascend-execute" [label="普通 Python 方法调用",style="solid"];
"ascend-execute" -> "core-execute" [label="super().execute_model",style="solid"];
"core-execute" -> "metadata" [label="动态绑定的准备方法",style="solid"];
"metadata" -> "outer-model" [label="准备好后继续父类 forward",style="solid"];
"outer-model" -> "worker-sample" [label="execute 返回后由 EngineCore 再提交",style="dashed"];
"worker-sample" -> "update" [label="ModelRunnerOutput 经 Executor 返回",style="dashed"];
"update" -> "engine-step" [label="仍有未完成请求",style="dashed"];
}