digraph G {
graph [rankdir=TB, bgcolor="transparent", pad="0.2", nodesep="0.4", ranksep="0.45", fontname="Noto Sans CJK SC"];
node [shape=box, style="rounded,filled", color="#bccbda", fontname="Noto Sans CJK SC", fontsize=13, margin="0.16,0.12"];
edge [fontname="Noto Sans CJK SC", fontsize=11, color="#5b6f84", arrowsize=0.7];

"outer-model" [label="AscendDeepseekV41ForCausalLM\nvl_model.py 的外层 wrapper",fillcolor="#e6f3e9",URL="#src-outer-model",tooltip="AscendDeepseekV41ForCausalLM\nvl_model.py 的外层 wrapper"];
"llm-forward" [label="self.language_model\nAscendDeepseekV41LLMForCausalLM",fillcolor="#e6f3e9",URL="#src-llm-forward",tooltip="self.language_model\nAscendDeepseekV41LLMForCausalLM"];
"backbone" [label="language_model.self.model\nDeepseekV41Model：遍历主干层",fillcolor="#e6f3e9",URL="#src-backbone",tooltip="language_model.self.model\nDeepseekV41Model：遍历主干层"];
"layer" [label="DeepseekV41DecoderLayer.forward\nAttention 子层 + FFN 子层",fillcolor="#e6f3e9",URL="#src-layer",tooltip="DeepseekV41DecoderLayer.forward\nAttention 子层 + FFN 子层"];
"attention" [label="本层 Attention\nself.self_attn(...) / Attention.forward",fillcolor="#e6f3e9",URL="#src-attention",tooltip="本层 Attention\nself.self_attn(...) / Attention.forward"];
"dsa-op" [label="torch.ops.vllm.dsa_v41_forward\nAscend 注册的自定义 op 边界",fillcolor="#e6f3e9",URL="#src-dsa-op",tooltip="torch.ops.vllm.dsa_v41_forward\nAscend 注册的自定义 op 边界"];
"dsa-impl" [label="AscendDSAV41Impl.forward\nQ/KV → Indexer → Attention → o_proj",fillcolor="#e6f3e9",URL="#src-dsa-impl",tooltip="AscendDSAV41Impl.forward\nQ/KV → Indexer → Attention → o_proj"];
"moe" [label="本层 FFN\nself.mlp(...) / MoE.forward",fillcolor="#e6f3e9",URL="#src-moe",tooltip="本层 FFN\nself.mlp(...) / MoE.forward"];
"moe-backend" [label="FusedMoE / quant / comm 分派\nMegaMoE、GMM 等后端",fillcolor="#e6f3e9",URL="#src-moe-backend",tooltip="FusedMoE / quant / comm 分派\nMegaMoE、GMM 等后端"];
"tail" [label="所有目标层之后\n辅助 hidden 写回 / collapse / norm",fillcolor="#e6f3e9",URL="#src-tail",tooltip="所有目标层之后\n辅助 hidden 写回 / collapse / norm"];
"core-sample" [label="返回 hidden_states\n随后经 sample_tokens 计算 logits / 采样",fillcolor="#e7f0fc",URL="#src-core-sample",tooltip="返回 hidden_states\n随后经 sample_tokens 计算 logits / 采样"];
"outer-model" -> "llm-forward" [label="forward",style="solid"];
"llm-forward" -> "backbone" [label="forward",style="solid"];
"backbone" -> "layer" [label="层循环 / bounded replay 后段包装",style="solid"];
"layer" -> "attention" [label="先执行",style="solid"];
"attention" -> "dsa-op" [label="调用",style="solid"];
"dsa-op" -> "dsa-impl" [label="注册的 Python 实现",style="solid"];
"dsa-impl" -> "moe" [label="Attention 返回后继续本层 FFN",style="solid"];
"moe" -> "moe-backend" [label="路由 / 量化 / 通信选型",style="solid"];
"moe-backend" -> "tail" [label="完成各层循环后",style="dashed"];
"tail" -> "core-sample" [label="回到 Runner",style="dashed"];
}