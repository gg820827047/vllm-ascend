-                seqused_k=qli_seqused_k,
-                cmp_residual_k=qli_cmp_residual_k,
-                batch_size=num_reqs,
-                max_seqlen_q=max_seqlen_q,
-                max_seqlen_k=max_seqlen_k // 4,
