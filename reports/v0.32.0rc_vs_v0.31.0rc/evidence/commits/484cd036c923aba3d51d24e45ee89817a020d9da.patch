-def _situ(values: torch.Tensor) -> torch.Tensor:
-    gate, up = values.float().chunk(2, dim=-1)
-    gate = K3_BETA * torch.tanh(gate / K3_BETA) * torch.sigmoid(gate)
-    up = K3_LINEAR_BETA * torch.tanh(up / K3_LINEAR_BETA)
-    return gate * up
