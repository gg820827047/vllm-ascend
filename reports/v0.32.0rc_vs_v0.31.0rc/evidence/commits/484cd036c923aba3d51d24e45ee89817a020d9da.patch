-    weight_scale = torch.linspace(0.0007, 0.0017, width, dtype=torch.float32)
-    activation_scale = torch.linspace(0.025, 0.075, rows, dtype=torch.float32).reshape(rows, 1)
-    return accumulator, weight_scale, activation_scale
