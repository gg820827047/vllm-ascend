diff --git a/.github/workflows/pr_test.yaml b/.github/workflows/pr_test.yaml
index 56802cf41..1e010741b 100644
--- a/.github/workflows/pr_test.yaml
+++ b/.github/workflows/pr_test.yaml
@@ -227,6 +227,7 @@ jobs:
