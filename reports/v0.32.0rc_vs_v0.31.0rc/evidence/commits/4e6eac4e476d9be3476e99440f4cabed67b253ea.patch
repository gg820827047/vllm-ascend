-            "scheduler_config": {"recompute_scheduler_enable": true},
-            "multistream_overlap_shared_expert": true,
-            "finegrained_tp_config": {"lmhead_tensor_parallel_size": 16}
-          }' \
-          --kv-transfer-config \
-          '{
-            "kv_connector": "MooncakeConnectorV1",
-            "kv_role": "kv_consumer",
-            "kv_port": "36000",
-            "kv_connector_extra_config": {
-              "prefill": {
-                "pp_size": 2,
-                "dp_size": 1,
-                "tp_size": 8
-              },
-              "decode": {
