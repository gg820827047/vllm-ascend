+    g1: torch.Tensor,
+    beta: torch.Tensor,
+    g2: torch.Tensor,
+    core_attn_out: torch.Tensor,
+    layer_name: str,
+) -> None:
+    return
+
+
+direct_register_custom_op(
+    op_name="glm5next_kda_forward",
+    op_func=glm5next_kda_forward,
+    mutates_args=["core_attn_out"],
+    fake_impl=glm5next_kda_forward_fake,
+)
