@@ -0,0 +1,68 @@
+name: Recipes Preview
+
+# Reuse vllm-project/recipes for preview builds, cleanup, and production sync.
+# Enable only after its receiver routes events by source; the original receiver
+# treats every preview-pr event as a vLLM PR, even if a source is supplied.
+#
+# pull_request_target allows fork PRs to use the dispatch App. Never check out
+# or run PR code here. Only a fixed source name and a validated PR number leave
+# this workflow. Keep the App key in the main-only recipes-preview environment.
+
+on:
+  pull_request_target:
+    branches: [main]
+    types: [opened, synchronize, reopened, closed]
+    paths:
+      - 'recipes/**'
+  push:
+    branches: [main]
+    paths:
+      - 'recipes/**'
+
+permissions:
+  contents: read
+
+concurrency:
+  group: recipes-preview-${{ github.event.pull_request.number || github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  dispatch:
+    if: >-
+      github.repository == 'vllm-project/vllm-ascend' &&
+      vars.RECIPES_PREVIEW_ENABLED == 'true'
+    runs-on: ubuntu-latest
+    timeout-minutes: 5
+    environment:
+      name: recipes-preview
+      url: >-
+        ${{ github.event_name == 'push' && 'https://recipes.vllm.ai' ||
+        (github.event.action != 'closed' &&
+        format('https://vllm-recipes-git-preview-vllm-ascend-pr-{0}-inferact-inc.vercel.app', github.event.pull_request.number) ||
+        '') }}
+    steps:
+      - name: Create a token for vllm-project/recipes
+        id: token
+        uses: actions/create-github-app-token@bcd2ba49218906704ab6c1aa796996da409d3eb1 # v3.2.0
+        with:
+          app-id: ${{ vars.RECIPES_APP_ID }}
+          private-key: ${{ secrets.RECIPES_APP_PRIVATE_KEY }}
+          owner: vllm-project
+          repositories: recipes
+          permission-contents: write
+
+      - name: Dispatch to vllm-project/recipes
+        env:
+          GH_TOKEN: ${{ steps.token.outputs.token }}
+          EVENT: ${{ github.event_name }}
+          PR: ${{ github.event.pull_request.number }}
+        run: |
+          if [ "$EVENT" = push ]; then
+            gh api repos/vllm-project/recipes/dispatches \
+              -f event_type=recipes-updated -f 'client_payload[source]=vllm-ascend'
+            exit 0
+          fi
+          [[ "$PR" =~ ^[1-9][0-9]*$ ]] || { echo "Invalid PR number: $PR"; exit 1; }
+          gh api repos/vllm-project/recipes/dispatches \
+            -f event_type=preview-pr -f 'client_payload[source]=vllm-ascend' \
+            -F "client_payload[pr]=${PR}"
