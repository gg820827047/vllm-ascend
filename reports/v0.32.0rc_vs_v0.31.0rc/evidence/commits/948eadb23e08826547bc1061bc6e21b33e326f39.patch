 def test_gemma4_26b_a4b_moe_full_decode_graph() -> None:
     """Verify Gemma4 MoE startup, graph capture, and short generation."""
     _run_full_decode_graph_smoke("google/gemma-4-26B-A4B-it", enable_expert_parallel=True)
