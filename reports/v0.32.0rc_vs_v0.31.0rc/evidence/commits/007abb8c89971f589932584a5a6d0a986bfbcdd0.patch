+    hardware_overrides:
+      npu:
+        args:
+          - '--reasoning-parser'
+          - deepseek_v4
+  spec_decoding:
+    hardware_overrides:
+      npu:
+        args: []
+variants:
+  default:
+    hardware_overrides:
+      ascend_950pr_8x:
+        docker_image: quay.io/ascend/vllm-ascend:v0.23.0-a5
+        install:
+          pip: false
+      ascend_950dt_8x:
+        docker_image: quay.io/ascend/vllm-ascend:v0.23.0-a5
+        install:
+          pip: false
