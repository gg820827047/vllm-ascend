+        if _is_minimax_m3_fp8_kv_cache(get_current_vllm_config_or_none()):
+            return [_MINIMAX_M3_FP8_KV_CACHE_BLOCK_SIZE, 128]
+        return [128]
+
+    @classmethod
+    def supports_pcp(cls) -> bool:
