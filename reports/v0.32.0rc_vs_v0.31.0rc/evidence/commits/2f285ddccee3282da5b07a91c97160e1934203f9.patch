+    _, plan = v2_glm_cache_plan
+    plan.kv_cache_tensors[0] = replace(plan.kv_cache_tensors[0], **descriptor_changes)
+
+    with pytest.raises(ValueError, match="Invalid padded shared-slot KV cache descriptor geometry"):
