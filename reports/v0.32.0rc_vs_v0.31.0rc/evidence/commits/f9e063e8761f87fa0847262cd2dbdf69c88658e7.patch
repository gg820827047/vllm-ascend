+    def test_role_fields_for_query_cache_and_combined_builds(self):
+        for role, ratio in (
+            ("State", 4),
+            ("State", 128),
+            ("SWA", 0),
+            ("Attention", 4),
+            ("Attention", 128),
+            ("Indexer", 4),
