+        slot_mapping_sfa: torch.Tensor,
+        attn_metadata: M,
+    ) -> tuple[torch.Tensor | None, torch.Tensor | None]:
+        if (
+            self.uses_packed_sfa_main_cache
+            and k_nope is not None
