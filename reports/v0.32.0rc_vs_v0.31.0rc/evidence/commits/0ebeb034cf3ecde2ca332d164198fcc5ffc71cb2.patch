+
+    from vllm_ascend.ascend_config import get_ascend_config
+
+    spec_config = vllm_config.speculative_config
+    if spec_config is None:
+        return None
+    max_spec_len = spec_config.num_speculative_tokens
+    if max_spec_len <= 0:
+        return None
